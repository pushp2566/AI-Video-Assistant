# Preferred Cloud LLM: Groq API Key (Get free key from https://console.groq.com/)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional fallback Cloud LLM: Mistral AI API Key (https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional Local LLM (Ollama): Set model name if running LLM on your local machine
# OLLAMA_MODEL=llama3:8b
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: Local OpenAI Whisper Model Size (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Optional: Sarvam AI API Key (Required ONLY for Hinglish audio transcription - https://www.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5
