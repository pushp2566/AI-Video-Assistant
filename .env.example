# ── AI Video Assistant Environment Variables ──

# Required: Mistral AI API Key (Get yours from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Optional: Local OpenAI Whisper Model Size (tiny, base, small, medium, large)
WHISPER_MODEL=small

# Optional: Sarvam AI API Key (Required ONLY for Hinglish audio transcription - https://www.sarvam.ai/)
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Sarvam STT Model Version
SARVAM_STT_MODEL=saaras:v2.5
